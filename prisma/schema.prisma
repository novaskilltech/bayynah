datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  REVIEWER
  ADMIN
}

enum SchoolType {
  HADITH
  FIQH
  AQIDA
  CRITIQUE
}

enum CertaintyLevel {
  ETABLI
  FORTEMENT_ETABLI
  KHILAF_RECONNU
  EXPERTISE_REQUISE
  INSUFFISANT
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum CitationStatus {
  VERIFIED_VERBATIM
  VERIFIED_PARAPHRASE
  TO_BE_CHECKED
}

enum TranslationStatus {
  TRANSLATION_OFFICIAL
  TRANSLATION_PROPOSED
  TRANSLATION_REVISED
}

enum EvidenceType {
  QURAN
  HADITH
  ATHAR
  BOOK
  CONTEMPORARY
}

enum EvidenceRole {
  PRIMARY_PROOF
  COUNTER_ARGUMENT
  EXPLANATORY_ATHAR
  REVEALED_STEP
  SCHOLARLY_EXPLANATION
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String?
  role              Role              @default(USER)
  
  // Relations d'attribution scientifique et de révision
  authoredLessons   Lesson[]          @relation("AuthoredLessons")
  reviewedLessons   Lesson[]          @relation("ReviewedLessons")
  authoredInquiries Inquiry[]         @relation("AuthoredInquiries")
  reviewedInquiries Inquiry[]         @relation("ReviewedInquiries")
  
  lessonProgress          LessonProgress[]
  inquiryProgress         InquiryProgress[]
  revisions               Revision[]
  
  // Phase 6 & 6.1 : Données d'apprentissage, sessions et attestations
  sessions                Session[]
  skillAttempts           SkillAttempt[]
  diagnosticAttempts      DiagnosticAttempt[]
  finalAssessmentAttempts FinalAssessmentAttempt[]
  learningProfile         LearningProfile?
  attestations            Attestation[]
  auditLogs               AuditLog[]
  
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Lesson {
  id              String            @id
  slug            String            @unique
  school          SchoolType
  level           Int               @default(1)
  order           Int
  titleFr         String
  titleAr         String
  summaryFr       String
  summaryAr       String
  contentFr       String            @db.Text
  contentAr       String?           @db.Text
  methodologyFr   String
  methodologyAr   String
  quizzes         Quiz[]
  progress        LessonProgress[]
  
  // Statut éditorial
  editorialStatus EditorialStatus   @default(DRAFT)
  
  authorId        String
  author          User              @relation("AuthoredLessons", fields: [authorId], references: [id])
  reviewerId      String?
  reviewer        User?             @relation("ReviewedLessons", fields: [reviewerId], references: [id])
  
  reviewedAt      DateTime?
  lastVerifiedAt  DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Quiz {
  id           String      @id @default(cuid())
  lessonId     String
  lesson       Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionFr   String
  questionAr   String
  options      Json        // [{ textFr, textAr, isCorrect, feedbackFr, feedbackAr }]
  order        Int         @default(1)
}

model Inquiry {
  id                 String             @id
  slug               String             @unique
  domain             SchoolType
  titleFr            String
  titleAr            String
  claimFr            String
  claimAr            String
  steps              Json               // Étapes ordonnées avec options et feedbacks
  conclusionSheet    Json               // Fiche standardisée avec evidenceIds traçables
  certaintyLevel     CertaintyLevel
  
  // Statut éditorial
  editorialStatus    EditorialStatus    @default(DRAFT)
  
  // Relation structurée via InquiryEvidence
  inquiryEvidences   InquiryEvidence[]
  progress           InquiryProgress[]
  
  authorId           String
  author             User               @relation("AuthoredInquiries", fields: [authorId], references: [id])
  reviewerId         String?
  reviewer           User?              @relation("ReviewedInquiries", fields: [reviewerId], references: [id])
  
  reviewedAt         DateTime?
  lastVerifiedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Evidence {
  id                 String             @id
  type               EvidenceType
  referenceCode      String             // Ex: "Coran 2:256", "Sahih Muslim 360", "Al-Majmu' 2/45"
  primarySource      Boolean            // Pas de valeur par défaut silencieuse
  
  // Rigueur philologique
  quoteArOriginal    String             @db.Text
  quoteArVocalized   String?            @db.Text
  quoteArNormalized  String?            @db.Text
  translationFr      String             @db.Text
  translator         String?
  translationStatus  TranslationStatus  @default(TRANSLATION_PROPOSED)
  citationStatus     CitationStatus     @default(TO_BE_CHECKED) // Non vérifié par défaut
  
  // Champs spécifiques aux types de sources
  surahNumber        Int?
  ayahNumber         Int?
  surahNameAr        String?
  surahNameFr        String?
  
  collection         String?            // Ex: "Sahih Muslim"
  hadithNumber       String?            // Ex: "360"
  numberingSystem    String?            // Ex: "Fuad Abdul Baqi"
  chapterAr          String?
  chapterFr          String?
  narrator           String?            // Pour Athar (Compagnon ou Tâbi'î)
  sourceWork         String?            // Ouvrage pour Livre/Athar
  author             String?            // Auteur humain
  editionVolumePage  String?            // Localisation physique (tome, page)
  authenticityGrade  String?            // Sahih, Hasan, Da'if, Mawdu', etc.
  gradeScholar       String?            // Qui a jugé ?
  
  // Traçabilité de la vérification
  verifiedAt         DateTime?
  verifiedBy         String?
  consultationUrl    String?
  lastVerifiedAt     DateTime?
  
  inquiryEvidences   InquiryEvidence[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Modèle intermédiaire d'attribution et de rôle des preuves par enquête
model InquiryEvidence {
  id          String       @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  evidenceId  String
  evidence    Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  
  role        EvidenceRole @default(PRIMARY_PROOF)
  order       Int          @default(1)
  stepNumber  Int?         // Numéro de l'étape du Laboratoire qui révèle cette preuve
  commentFr   String?      @db.Text
  commentAr   String?      @db.Text

  @@unique([inquiryId, evidenceId, role])
}

model Revision {
  id              String      @id @default(cuid())
  entityType      String      // LESSON | INQUIRY | EVIDENCE
  entityId        String
  changeSummaryFr String
  changedByUserId String
  changedBy       User        @relation(fields: [changedByUserId], references: [id])
  createdAt       DateTime    @default(now())
}

// Suivi de progression distinct pour les leçons
model LessonProgress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizScore   Int?
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([userId, lessonId])
}

// Suivi de progression distinct pour les enquêtes
model InquiryProgress {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiryId      String
  inquiry        Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  stepsCompleted Int         @default(0)
  completed      Boolean     @default(false)
  completedAt    DateTime?
  createdAt      DateTime    @default(now())

  @@unique([userId, inquiryId])
}

// ==========================================
// PHASE 6 : ENUMS ET MODÈLES D'APPRENTISSAGE
// ==========================================

enum AttestationType {
  PARCOURS
  MAITRISE_METHODOLOGIQUE
}

enum SyncStatus {
  PENDING
  SYNCED
}

model SkillAttempt {
  id               String   @id // UUID généré par le client pour idempotence
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId          String
  contextId        String   // Ex: "inquiry-01", "lesson-05", "diag-01", "final-eval"
  contextType      String   // "LESSON" | "INQUIRY" | "DIAGNOSTIC" | "FINAL_ASSESSMENT"
  score            Float    // 0.0 à 1.0
  weight           Float    @default(1.0)
  metadata         Json?    // Détails de la réponse, question, etc.
  clientTimestamp  DateTime
  createdAt        DateTime @default(now())

  @@index([userId, skillId])
  @@index([userId, contextId])
}

model DiagnosticAttempt {
  id               String   @id // UUID
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scorePercent     Float
  answers          Json     // Record<string, string>
  rulesVersion     String   @default("diagnostic-v1")
  clientTimestamp  DateTime
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model FinalAssessmentAttempt {
  id                             String   @id // UUID
  userId                         String
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scorePercent                   Float
  answers                        Json     // Record<string, string>
  rulesVersion                   String   @default("assessment-v1")
  eligibleForPathAttestation     Boolean  @default(false)
  eligibleForMasteryAttestation  Boolean  @default(false)
  clientTimestamp                DateTime
  createdAt                      DateTime @default(now())

  @@index([userId, createdAt])
}

model LearningProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluatedSkillsCount Int      @default(0)
  globalScorePercent   Float    @default(0.0)
  skillsData           Json     // Record<SkillId, SkillProgression>
  observedPatterns     Json     // IdentifiedMethodologicalPattern[]
  rulesVersion         String   @default("skills-v1")
  lastRecalculatedAt   DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Attestation {
  id                      String          @id // Ex: "ATT-2026-..."
  userId                  String
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                    AttestationType
  recipientName           String
  publicNameConsent       Boolean         @default(false) // Consentement explicite pour affichage public
  issuedAt                DateTime        @default(now())
  rulesVersion            String          @default("skills-v1")
  keyVersion              String          @default("v1") // Identifiant de clé (kid) pour rotation
  canonicalPayload        String?         @db.Text       // Payload canonique signé
  finalScorePercent       Float
  demonstratedSkillsCount Int
  contextCount            Int
  verificationHash        String          @unique
  revoked                 Boolean         @default(false)
  revokedReason           String?
  metadata                Json?
  createdAt               DateTime        @default(now())

  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique // Hachage SHA-256 du jeton opaque aléatoire
  csrfTokenHash String?  // Hachage SHA-256 du jeton CSRF lié à la session (Synchronizer Token Pattern)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userAgent     String?
  ipAddress     String?

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // Ex: "SYNC_ATTEMPTS", "RECALCULATE_PROFILE", "ISSUE_ATTESTATION", "EXPORT_DATA", "DELETE_ACCOUNT"
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}


