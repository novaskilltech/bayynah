# Environment variables for TABAYYUN
# Copy this file to .env and adjust values for your environment

# NEVER reuse development secrets in production.
# Production secrets must be configured in the deployment platform.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tabayyun?schema=public"

# CSRF
CSRF_SECRET="dev-only-change-me"

# Attestation keyring
ATTESTATION_KEY_V1="dev-only-change-me"
ATTESTATION_ACTIVE_KEY_VERSION="v1"

# Distributed rate limiting — production
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
